# Dev stand-in for the Raspberry Pi. arm64 Debian Bookworm (native on Apple
# silicon and on GitHub's ubuntu-24.04-arm runners) running the SAME
# provisioning/install-toolchain.sh the Pi runs. Docker is dev/CI only; the
# Pi runs the script directly (STRATEGY.md "Dev & deploy").
FROM debian:bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app
RUN PREFIX=/opt/turret-lab REPO_DIR=/app provisioning/install-toolchain.sh

# Smoke test baked into the image: a sketch using the whitelisted libraries
# must compile for the Nano. A broken toolchain fails the build, so CI's
# docker build IS the toolchain test.
RUN mkdir -p /tmp/smoke/smoke \
 && printf '#include <Servo.h>\n#include <IRremote.hpp>\nServo s;\nvoid setup(){ s.attach(10); IrReceiver.begin(9); }\nvoid loop(){}\n' \
      > /tmp/smoke/smoke/smoke.ino \
 && /opt/turret-lab/bin/arduino-cli --config-file /opt/turret-lab/arduino/arduino-cli.yaml \
      compile --fqbn arduino:avr:nano /tmp/smoke/smoke \
 && rm -rf /tmp/smoke

ENV PATH="/opt/turret-lab/venv/bin:/opt/turret-lab/bin:$PATH" \
    FAKE_BOARD=1
EXPOSE 8000
CMD ["uvicorn", "hacklab.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
